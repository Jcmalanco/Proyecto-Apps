<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".AttorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Attor"
        android:usesCleartextTraffic="false">

        <!-- Login: se abre cuando el invitado decide iniciar sesión -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Punto de entrada real de la app: Home con bottom navigation -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.workdetails.WorkDetailsActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.reader.ReaderActivity"
            android:exported="false"
            android:parentActivityName=".ui.workdetails.WorkDetailsActivity" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.profile.ProfileActivity" />

        <activity
            android:name=".ui.seeall.SeeAllActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

    </application>
</manifest>
